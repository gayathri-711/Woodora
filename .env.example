# WOODORA Environment Configuration Template
# Duplicate this file to .env and configure your local or production credentials.

# Application Server
PORT=8000
NODE_ENV=development
APP_URL=http://localhost:8000

# Security & Session Secrets
JWT_SECRET=woodora_luxury_furniture_master_secret_key_2026
SESSION_LIFETIME_DAYS=7

# Database Configuration (Defaults to zero-dependency SQLite)
DB_PATH=data/woodora.sqlite

# E-Commerce & Calculations
TAX_RATE=0.05
FREE_SHIPPING_THRESHOLD=250.00
STANDARD_SHIPPING_FEE=15.00
PROMO_CODE_WELCOME=WOODORA10
PROMO_DISCOUNT_PERCENT=10.0

# SMTP Email Notification Service (Configurable)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="WOODORA Atelier Concierge <concierge@woodora.com>"

# Payment Provider Sandbox (Stripe / Mock Gateway)
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_woodora
STRIPE_SECRET_KEY=sk_test_placeholder_woodora
STRIPE_WEBHOOK_SECRET=whsec_placeholder_woodora
